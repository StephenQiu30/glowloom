# Local processes read the root .env. This template contains example values only.
# Copy it only if .env does not already exist; keep real credentials untracked.
GLOWLOOM_ENV=local
GLOWLOOM_LOG_LEVEL=info
GLOWLOOM_HTTP_ADDR=127.0.0.1:8080
# Browser Origin and the Next.js internal API rewrite are separate addresses.
GLOWLOOM_PUBLIC_ORIGIN=http://localhost:1122
GLOWLOOM_API_BASE_URL=http://127.0.0.1:1123
GLOWLOOM_WORKER_HEALTH_ADDR=:8081
GLOWLOOM_RELAY_HEALTH_ADDR=:8082
# Default development Compose fixes frontend/backend host ports to 1122/1123.
# It also fixes PUBLIC_ORIGIN to http://localhost:1122, ignoring env overrides.
# Development forwards these host middleware ports inside backend containers.
# Add a local Whisper port if GLOWLOOM_WHISPER_ENDPOINT uses a loopback address.
GLOWLOOM_HOST_SERVICE_PORTS=5432 6379 9000 9092
PORT=3000

# Backend roles require a reachable business database and their service configuration.
# Replace the database placeholder with access to the service already running here.
GLOWLOOM_DB_DSN=postgres://glowloom:replace-me@127.0.0.1:5432/glowloom?sslmode=disable
# Only `glowloom partitions ensure` uses this separate owner account on the same database.
GLOWLOOM_PARTITION_MAINTENANCE_DB_DSN=postgres://glowloom_owner:replace-me@127.0.0.1:5432/glowloom?sslmode=disable
GLOWLOOM_REDIS_URL=redis://127.0.0.1:6379/0

# The relay publishes Outbox rows and consumes supported realtime events through this broker.
GLOWLOOM_KAFKA_BROKERS=127.0.0.1:9092

# Object storage uses Tencent Cloud COS through one strict JSON registry (schema_version=1).
# Configure immutable profiles, default_write_profile and bounded upload/access/limits.
# Credentials are references, e.g. source=env/access_key_env=GLOWLOOM_STORAGE_ACCESS_KEY.
# Existing object locations keep their original profile; changing a default does not migrate data.
# See backend/config/COS配置说明.md for the registry example and migration steps.
GLOWLOOM_OBJECT_STORAGE_CONFIG=
GLOWLOOM_STORAGE_ACCESS_KEY=
GLOWLOOM_STORAGE_SECRET_KEY=
GLOWLOOM_STORAGE_SESSION_TOKEN=

# Generated-result downloads require exact HTTPS provider origins. A local TLS
# fixture may opt into loopback only in GLOWLOOM_ENV=local; keep it off for real media.
GLOWLOOM_MEDIA_RESULT_ALLOWED_ORIGINS=
GLOWLOOM_MEDIA_ALLOW_TEST_LOOPBACK_TLS=false
# 可选本机 whisper.cpp 根地址。留空时新字幕任务明确不可用；不含 /inference。
GLOWLOOM_WHISPER_ENDPOINT=

# Offline Video Depth Anything Small runtime. Set all four together to enable.
GLOWLOOM_VIDEO_DEPTH_PYTHON_PATH=
GLOWLOOM_VIDEO_DEPTH_SOURCE_DIR=
GLOWLOOM_VIDEO_DEPTH_MODEL_PATH=
GLOWLOOM_VIDEO_DEPTH_DEVICE=

# Provider credential encryption. Keep all configuration in this single .env.
# PEM values may contain escaped \n; never put real keys in this example.
# REQUEST_MAC_KEY must be 32 random bytes encoded as 64 hexadecimal characters.
# With PRIVATE_KEY_PEM configured, --role=all also starts the provider worker.
GLOWLOOM_CREDENTIAL_KEY_ID=
GLOWLOOM_CREDENTIAL_PUBLIC_KEY_PEM=
GLOWLOOM_CREDENTIAL_PRIVATE_KEY_PEM=
GLOWLOOM_CREDENTIAL_REQUEST_MAC_KEY=

# Optional OTLP/HTTP collector origin. Leave empty when no host collector is running.
GLOWLOOM_OTEL_ENDPOINT=

# Required by the default private canvas-collaboration service and API.
# Generate one random value of at least 32 bytes; keep it identical on both sides.
# Compose injects GLOWLOOM_CANVAS_RUNTIME_URL=http://canvas-collaboration:4400.
GLOWLOOM_COLLAB_RUNTIME_TOKEN=

# Identity configuration is injected directly from this .env file, without key-file mounts.
# GLOWLOOM_IDENTITY_KEY: compact JSON {"key_id":"...","proof_key":"base64 32 bytes","encryption_key":"independent base64 32 bytes"}.
# Preserve existing values when migrating; never generate fresh keys on process startup.
GLOWLOOM_IDENTITY_KEY=
# JWT uses github.com/golang-jwt/jwt/v5 (RS256).
# PRIVATE_KEY is base64 PEM; VERIFY_KEYS is JSON {"kid":"base64 public PEM"}.
# Verification-only rollback keeps VERIFY_KEYS while disabling issuance.
# Fixed UTC RFC3339 deadline. Required only when session v2 is enabled, and at most seven days ahead of process start.
GLOWLOOM_IDENTITY_LEGACY_UPGRADE_UNTIL=
GLOWLOOM_IDENTITY_SESSION_V2_ENABLED=false
GLOWLOOM_IDENTITY_JWT_PRIVATE_KEY=
GLOWLOOM_IDENTITY_JWT_VERIFY_KEYS=
GLOWLOOM_IDENTITY_JWT_ACTIVE_KID=
# Independent 32-byte key, encoded as base64.
GLOWLOOM_IDENTITY_REFRESH_RECEIPT_KEY=
GLOWLOOM_IDENTITY_TERMS_VERSION=
GLOWLOOM_IDENTITY_MAIL_SOURCE_HOURLY_LIMIT=0
GLOWLOOM_IDENTITY_MAIL_GLOBAL_HOURLY_LIMIT=0
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Glowloom

# Optional host worker: go run ./cmd/glowloom --role=worker --queues=agent.codex (from backend/).
# Local PoC: Codex CLI 0.159.2 from PATH; empty HOME uses the CLI current login.
# No Codex container. Empty WORK_ROOT uses owner-only user cache/glowloom/codex-trials.
# Non-local environments still require a dedicated HOME and native executable.
GLOWLOOM_CODEX_BINARY=
GLOWLOOM_CODEX_HOME=
GLOWLOOM_CODEX_WORK_ROOT=

# Explicit database owner connection for the storage operator only; never used by API/workers.
GLOWLOOM_STORAGE_MAINTENANCE_DSN=

# Independent agent service. Provision its offline SQL and restricted role first.
GLOWLOOM_AGENT_DB_DSN=postgres://glowloom_agent:replace-me@host.docker.internal:5432/glowloom?sslmode=disable
GLOWLOOM_AGENT_SERVICE_TOKEN=
GLOWLOOM_AGENT_BUSINESS_TOKEN=
