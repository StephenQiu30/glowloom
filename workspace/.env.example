# Runtime only. Copy to .env locally; never include in builds or Git.
WORKSPACE_PORT=1130
GLOWLOOM_WORKSPACE_ORIGIN=http://127.0.0.1:1130
# Dedicated LOGIN granted glowloom_workspace; never use a business/admin role.
GLOWLOOM_WORKSPACE_DB_DSN=
# Empty uses a generated 0600 .local/access-token. Do not use NEXT_PUBLIC_*.
# GLOWLOOM_WORKSPACE_SESSION_SECRET=
# Optional verified local CLI; desktop app CLI is discovered automatically.
# GLOWLOOM_WORKSPACE_CODEX_BINARY=
