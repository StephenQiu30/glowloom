{
  "name": "@glowloom/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm prepare:ui && tsc --noEmit",
    "check:content": "tsx scripts/check-content.ts",
    "build:static": "tsx scripts/build.ts static",
    "build:online": "tsx scripts/build.ts online",
    "serve:static": "tsx scripts/serve-static.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/start-online.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "prepare:ui": "tsx scripts/prepare-ui.ts",
    "start:online": "node --env-file-if-exists=.env --import tsx scripts/start-online.ts",
    "import:narration": "tsx scripts/import-narration.ts",
    "release:select": "tsx scripts/select-release.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "geist": "1.8.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "pg": "8.16.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.0",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.6",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "pagefind": "1.6.0",
    "prettier": "3.9.9",
    "puppeteer-core": "25.17.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vitest": "5.0.2"
  }
}
