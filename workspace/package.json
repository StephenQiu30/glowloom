{
  "name": "@glowloom/workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node --env-file-if-exists=.env.local lib/sync-content.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 1130",
    "start": "next start --hostname 127.0.0.1 --port 1130",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "sync:search": "node --env-file-if-exists=.env.local lib/sync-content.ts",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.3",
    "geist": "1.8.1",
    "lucide-react": "^1.71.0",
    "meilisearch": "^0.63.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
