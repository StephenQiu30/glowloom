    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "exports": {
    "./recovery": {
      "types": "./types/recovery.d.ts",
      "default": "./dist/collaboration/recovery.js"
    },
    "./session": {
      "types": "./types/session.d.ts",
      "default": "./dist/collaboration/session.js"
    },
    "./journal": {
      "types": "./types/journal.d.ts",
      "default": "./dist/collaboration/journal.js"
    },
    "./wire": {
      "types": "./types/wire.d.ts",
      "default": "./dist/protocol/wire.js"
    },
    "./model": {
      "types": "./types/model.d.ts",
      "default": "./dist/document/model.js"
    },
    "./rich-text": {
      "types": "./types/rich-text-schema.d.ts",
      "default": "./dist/document/rich-text-schema.js"
    },
    "./service-document": {
      "types": "./types/service-document.d.ts",
      "default": "./dist/document/projection.js"
    },
    "./editor": "./editor/editor/canvas-editor.tsx",
    "./editor/*": "./editor/*"
  },
  "files": [
    "dist",
    "types",
    "editor"
  ],
  "peerDependencies": {
    "@tiptap/extension-collaboration": "3.32.0",
