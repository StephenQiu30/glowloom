{
  "name": "@glowloom/canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/server.js",
    "test": "pnpm build && node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "prettier --check src types tests package.json tsconfig.json",
    "check:editor": "prettier --check editor tsconfig.editor.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "12.3.3",
