// Client mapping only; backend/db/schema.sql owns all database structure.
generator client {
  provider               = "prisma-client"
  output                 = "../src/database/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  engineType             = "client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["agent"]
}

model RuntimeSession {
  session_id  String   @id
  owner_id    String
  owner_epoch BigInt
  lease_until DateTime @db.Timestamptz(6)
  last_id     BigInt   @default(1)
  commit_seq  BigInt   @default(0)

  @@map("runtime_sessions")
  @@schema("agent")
}

model RuntimeRecord {
  session_id            String
  id                    BigInt
  record_type           String
  body                  String
  commit_seq            BigInt
  conversation_id       BigInt?
  owner_conversation_id BigInt?
  owner_task_id         BigInt?
  parent_id             BigInt?
  parent_at             BigInt?
  head_id               BigInt?
  kind_key              String?
  status                String?
  background            Boolean?
  abort_requested       Boolean?
  request_key           String?
  scope_key             String?
  address_key           String?
  created_at_seq        BigInt?
  retired_at_seq        BigInt?

  @@id([session_id, id])
  @@map("runtime_records")
  @@schema("agent")
}

model RuntimeDocumentVersion {
  session_id        String
  document_id       BigInt
  commit_seq        BigInt
  version           Int
  content           String
  deltas_since_base Int

  @@id([session_id, document_id, commit_seq])
  @@map("runtime_document_versions")
  @@schema("agent")
}

model RuntimeEvent {
  session_id    String
  commit_seq    BigInt
  event_ordinal Int
  event_type    String
  payload       Json   @db.JsonB

  @@id([session_id, commit_seq, event_ordinal])
  @@map("runtime_events")
  @@schema("agent")
}

model ServiceSession {
  id                 String    @id @db.Uuid
  actor_id           String    @db.Uuid
  org_id             String    @db.Uuid
  scope_id           String    @db.Uuid
  project_id         String    @db.Uuid
  canvas_id          String?   @db.Uuid
  title              String
  request_id         String    @db.Uuid
  content_hash       String
  execution_revision BigInt    @default(0)
  created_at         DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  last_input_at      DateTime? @db.Timestamptz(6)
  pinned             Boolean   @default(false)
  archived_at        DateTime? @db.Timestamptz(6)

  @@unique([actor_id, project_id, request_id])
  @@map("service_sessions")
  @@schema("agent")
}

model ServiceRun {
  id                String   @id @db.Uuid
  session_id        String   @db.Uuid
  request_id        String   @db.Uuid
  content_hash      String
  goal              String
  manifest          Json     @db.JsonB
  submission_id     String   @db.Uuid
  accepted_revision BigInt
  created_at        DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  input             Json?    @db.JsonB
  retry_of_run_id   String?  @db.Uuid

  @@unique([session_id, request_id])
  @@map("service_runs")
  @@schema("agent")
}

model ServiceControlInbox {
  decision_id            String   @id @db.Uuid
  root_run_id            String   @db.Uuid
  authorization_revision BigInt
  content_hash           String
  input                  Json     @db.JsonB
  receipt                Json?    @db.JsonB
  created_at             DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@map("service_control_inbox")
  @@schema("agent")
}

model PublicMessage {
  session_id      String
  run_id          String @db.Uuid
  commit_seq      BigInt
  event_ordinal   Int
  part_index      Int
  message_id      String @db.Uuid
  conversation_id BigInt
  sequence        String
  kind            String
  content         String

  @@id([session_id, commit_seq, event_ordinal, part_index])
  @@map("public_messages")
  @@schema("agent")
}

model RecoveryBackoff {
  kind            String
  subject_id      String    @db.Uuid
  root_run_id     String    @db.Uuid
  attempts        Int       @default(0)
  code            String?
  next_attempt_at DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  parked_at       DateTime? @db.Timestamptz(6)

  @@id([kind, subject_id])
  @@map("recovery_backoff")
  @@schema("agent")
}
