{
  "name": "agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm run build && sh -c 'node_modules/.bin/tsc --watch -p tsconfig.build.json & compiler=$!; trap \"kill $compiler 2>/dev/null || true\" EXIT; node --watch --enable-source-maps dist/src/server.js'",
    "start": "node --enable-source-maps dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist/src\", { recursive: true, force: true })' && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run tests",
    "eval": "vitest run evals"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.108",
    "@ai-sdk/google": "^4.0.126",
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@mastra/core": "^1.86.0",
    "@mastra/evals": "^1.10.12",
    "@mastra/langfuse": "^1.7.2",
    "@mastra/mcp": "^2.11.0",
    "@mastra/memory": "^1.41.3",
    "@mastra/pg": "^1.38.0",
    "ai": "^7.0.181",
    "ioredis": "^5.6.1",
    "kysely": "0.28.20",
    "langfuse": "^3.38.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
