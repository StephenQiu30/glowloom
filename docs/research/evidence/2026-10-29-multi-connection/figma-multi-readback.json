    {
      "id": "3153:58493",
      "name": "多选连线 / 精确合同与验收边界 / 2026-10-29",
      "type": "TEXT",
      "x": 1953,
      "y": 2060,
      "width": 3650,
      "height": 297,
      "fills": [
